{
  "name": "pi-academic-research",
  "version": "0.2.0",
  "description": "Pi package wrapping Imbad0202/academic-research-skills: 4 academic research skills (paper writing, peer review, pipeline, deep research) adapted for the Pi coding agent, with Pi-native /ars-* prompt templates and subagents.",
  "keywords": [
    "pi-package",
    "academic",
    "research",
    "academic-writing",
    "peer-review"
  ],
  "license": "CC-BY-NC-4.0",
  "private": false,
  "author": "ChaoXu1997 (https://github.com/ChaoXu1997)",
  "homepage": "https://github.com/ChaoXu1997/pi-academic-research#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChaoXu1997/pi-academic-research.git"
  },
  "bugs": {
    "url": "https://github.com/ChaoXu1997/pi-academic-research/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "extensions/citation-gate.ts",
    "extensions/write-scope-guard.ts",
    "extensions/pipeline-integrity-gate.ts",
    "extensions/core/sprint-contract-core.ts",
    "extensions/sprint-contract-gate.ts",
    "extensions/ars_phase_scope_manifest.json",
    "prompts",
    "subagents",
    "scripts",
    "upstream/academic-paper",
    "upstream/academic-paper-reviewer",
    "upstream/academic-pipeline",
    "upstream/deep-research",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "bash scripts/init-submodule.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && cp extensions/ars_phase_scope_manifest.json .test-build/ && node .test-build/citation-gate.test.js && node .test-build/write-scope-guard.test.js && node .test-build/pipeline-integrity-gate.test.js && node .test-build/core/sprint-contract-core.test.js && node .test-build/sprint-contract-gate.test.js",
    "test:e2e": "tsc -p tsconfig.test.json && node .test-build/citation-gate.e2e.test.js",
    "prepublishOnly": "npm run typecheck && npm run test"
  },
  "pi": {
    "skills": [
      "upstream/academic-paper",
      "upstream/academic-paper-reviewer",
      "upstream/academic-pipeline",
      "upstream/deep-research"
    ],
    "prompts": [
      "prompts/*.md"
    ],
    "extensions": [
      "extensions/*.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
